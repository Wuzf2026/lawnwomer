<?xml version="1.0"?>
<package format="2">
  <name>rk3588_sdk</name>
  <version>1.0.0</version>
  <description>RK3588 Hardware SDK for ROS Noetic</description>
  <maintainer email="norco@norco.com">norco</maintainer>
  <license>MIT</license>

  <!-- 必须声明build依赖（与CMakeLists.txt的find_package对应） -->
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>  <!-- 补全缺失的std_msgs依赖 -->

  <!-- 运行依赖 -->
  <exec_depend>roscpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>    <!-- 补全运行时依赖 -->

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
