<launch>
    <!-- 启动RK3588 SDK节点 -->
    <node name="rk3588_sdk_node" pkg="rk3588_sdk" type="sdk_node" output="screen"/>

    <!-- 启动传感器（相机+雷达+RTK） -->
    <include file="$(find lawn_mower)/launch/sensors.launch"/>

    <!-- 启动电机控制+超声波 -->
    <include file="$(find lawn_mower)/launch/motor_control.launch"/>

    <!-- RVIZ可视化（可选） -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find lawn_mower)/config/lawn_mower.rviz" output="screen"/>
</launch>