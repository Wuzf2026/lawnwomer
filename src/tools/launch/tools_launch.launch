<launch>
  <!-- 调试工具总启动文件 -->
  <param name="tools/config_path" value="$(find tools)/config/tools_config.yaml"/>
  
  <!-- 可选：启动参数配置脚本 -->
  <node name="param_config" pkg="tools" type="param_config.py" output="screen" required="false"/>
  
  <!-- 可选：启动数据监控脚本 -->
  <node name="data_monitor" pkg="tools" type="data_monitor.py" output="screen" required="false"/>
  
  <!-- 可选：启动状态查询脚本 -->
  <node name="status_query" pkg="tools" type="status_query.py" output="screen" required="false"/>
</launch>