<?xml version="1.0"?>
<package format="2">  <!-- ROS1 Noetic使用format2 -->
    <name>orbbec_camera</name>
    <version>2.7.6</version>
    <description>Orbbec Gemini335 Camera package for RK3588 (ROS1 Noetic)</description>
    <maintainer email="mocun@orbbec.com">Joe Dong</maintainer>
    <license>Apache License 2.0</license>

    <buildtool_depend>catkin</buildtool_depend>

    <!-- 核心依赖 -->
    <depend>roscpp</depend>
    <depend>sensor_msgs</depend>
    <depend>cv_bridge</depend>
    <depend>image_transport</depend>
    <depend>camera_info_manager</depend>
    <depend>tf2_ros</depend>
    <depend>nodelet</depend>
    <depend>rk3588_sdk</depend>  <!-- 依赖RK3588底层SDK -->

    <!-- ARM64硬件依赖 -->
    <build_depend>libusb-1.0-dev</build_depend>
    <build_depend>libudev-dev</build_depend>
    <exec_depend>libusb-1.0-0</exec_depend>
    <exec_depend>libudev1</exec_depend>

    <export>
        <nodelet plugin="${prefix}/nodelet_plugins.xml"/>
    </export>
</package>