<?xml version="1.0"?>
<package format="2">
  <name>ultrasonic_sensor</name>
  <version>1.0.0</version>
  <description>Ultrasonic Sensor Driver for RK3588 (ROS Noetic) - Publish distance data to ROS</description>
  <maintainer email="dev@example.com">Ultrasonic Developer</maintainer>
  <license>MIT</license>

  <!-- 构建依赖 -->
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>rk3588_sdk</build_depend>
  
  <!-- 运行依赖 -->
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rk3588_sdk</exec_depend>

  <!-- 导出构建类型 -->
  <export>
    <build_type>cmake</build_type>
  </export>
</package>
