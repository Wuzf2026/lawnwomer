<launch>
  <node name="motor_control_node" pkg="motor_control" type="motor_control_node" output="screen">
    <param name="uart_dev" value="/dev/ttyS3" />
    <param name="uart_baud" value="115200" />
    <param name="kp" value="1.0" />
    <param name="ki" value="0.1" />
    <param name="kd" value="0.05" />
  </node>
</launch>